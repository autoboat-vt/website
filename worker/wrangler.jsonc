{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "autoboat-cloudflare-helper",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-19",
    "workers_dev": true,
    "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
    },
    // Public, non-secret configuration.
    "vars": {
        // Discord server (guild) ID whose scheduled events we're exposing.
        // Not a secret -- anyone in the guild can see this. Fill in after
        // creating the Discord application (see README.md).
        "DISCORD_GUILD_ID": "1017960606403416085",

        // Comma-separated allowlist of PUBLIC origins permitted to call this
        // Worker (the response echoes the caller's own Origin when it matches;
        // otherwise no Access-Control-Allow-Origin is sent and the browser
        // blocks the response).
        //
        // WARNING: `www.` is included deliberately, and it is not cosmetic. The www
        // host SERVES the site rather than redirecting to the apex (verified: it
        // 302s /calendar to /calendar/ and returns 200), so a visitor on
        // https://www.autoboat.aoe.vt.edu is genuinely at a DIFFERENT origin.
        // Omitting it produced exactly this: the calendar worked at the apex and
        // failed on www with a CORS block. The canonical tag pointing at the
        // apex does not help a browser -- it is a crawler hint, not a redirect.
        //
        // Local dev needs NO entry here: localhost / 127.0.0.1 / [::1] on any
        // port are allowed automatically (see LOCAL_DEV_ORIGIN_PATTERN in
        // src/index.ts), because the hostname and port both vary and enumerating
        // them is how this broke the first time.
        //
        // http:// variants are not listed: they 301 to https before the app
        // runs, so they can never be the page's origin.
        //
        // Blank allows nothing (safe). A lone "*" allows every origin, which is
        // a lockdown-off switch; a "*" mixed into a longer list fails closed.
        "ALLOWED_ORIGIN": "https://autoboat.aoe.vt.edu, https://www.autoboat.aoe.vt.edu",

        // How long to cache the Discord events payload in KV, in seconds.
        //
        // WARNING: This value is budgeted against the Workers KV FREE TIER, which
        // allows 1,000 WRITES/day (reads are 100,000, nowhere near the limit).
        // Every cache miss writes the events key, so the miss rate -- not the
        // request rate -- is what burns the budget:
        //
        //     misses/day = 86400 / TTL        writes/day = misses/day * writes per miss
        //     TTL  60s -> 1440 misses -> 1440 writes   OVER the 1,000 limit
        //     TTL 120s ->  720 misses ->  720 writes   ok (thin margin)
        //     TTL 180s ->  480 misses ->  480 writes   ok (this config)
        //     TTL 300s ->  288 misses ->  288 writes   ok (comfortable)
        //
        // 180s (3 minutes) is a deliberate refresh-vs-budget trade: it keeps
        // roughly 2x headroom for retries and deploys while refreshing twice as
        // often as 300s. Lowering it further cuts that headroom fast -- do the
        // arithmetic above before you do.
        //
        // WARNING: A too-short TTL does NOT degrade gracefully. If the write fails,
        // the entry never lands, so every following request is also a miss and
        // keeps trying to write -- the calendar goes empty and stays empty until
        // 00:00 UTC. Keep this at >= 180 unless the account moves to Workers Paid.
        //
        // Also advertised to calendar clients as REFRESH-INTERVAL /
        // X-PUBLISHED-TTL, so changing it changes how often subscribed
        // Google/Apple/Outlook calendars poll. Keep the website's
        // EVENTS_POLL_INTERVAL_MS in sync (it is only a READ-side concern now).
        "CACHE_TTL_SECONDS": "180",

        // OPTIONAL age-based pruning for the event archive, in days. LEFT UNSET
        // ON PURPOSE: the team asked to keep EVERY event, so the default is
        // unbounded retention and the KV key is written with no expiry.
        //
        // Discord's scheduled-events endpoint returns only SCHEDULED/ACTIVE
        // events, so an event disappears from the API the moment it completes
        // or is cancelled. The Worker archives what it has already seen and
        // keeps serving it -- forever, unless a value is set here.
        //
        // Setting this re-enables pruning older than N days. It does NOT affect
        // the KV write budget above: the miss rate is set by
        // CACHE_TTL_SECONDS alone, and a miss still costs exactly one write.
        // Total history is bounded regardless by MAX_ARCHIVED_EVENTS in
        // worker/src/archive.ts.
        //
        // "RETENTION_DAYS": "365",
        // Display name subscribers see in Google/Apple/Outlook Calendar for
        // the /calendar.ics feed. Public, non-secret. The /officers feed uses
        // its own default ("AutoBoat Officers") unless this is set.
        "CALENDAR_NAME": "AutoBoat at Virginia Tech",

        // Officer-only VOICE CHANNEL id. Events scheduled in this channel are
        // excluded from /events and /calendar.ics, and included only on
        // /officers/*. Every other channel is public. NOT a secret -- anyone in
        // the server can see a channel id.
        //
        // WARNING: Classified by CHANNEL, not category: every event voice channel
        // (officer, subteam, and general member) shares ONE category, so the
        // category cannot tell them apart.
        //
        // Blank means "no officer channel", which makes the Worker serve
        // NOTHING rather than guess (fail-closed). Omit the var entirely to use
        // DEFAULT_OFFICERS_CHANNEL_ID in worker/src/audience.ts.
        // Verify with `curl <worker-url>/audiences`.
        "OFFICERS_CHANNEL_ID": "1550594891766308997",

        // Discord application OAuth2 client id, for the "add event" login.
        // PUBLIC -- it appears in the authorize URL the browser visits. Find it
        // in the Discord developer portal -> your application -> OAuth2.
        "DISCORD_CLIENT_ID": "1550968963121283112",

        // Where Discord redirects back to after login. COMMA-SEPARATED, and
        // every entry must be registered in the portal's "Redirects" list
        // CHAR-FOR-CHAR, including the trailing slash -- Discord shows an error
        // page on a mismatch instead of a usable message.
        //
        // WHY MORE THAN ONE: a login should complete on the page that started
        // it. The Worker picks the entry whose PATH matches the page requesting
        // the login (see `redirectUriFor` in src/oauth.ts) and falls back to the
        // FIRST entry. So `/calendar/` is first because it is the fallback.
        //
        // WARNING: The URI is SELECTED from this list, never built from request
        // input. Constructing one from a path would make any path a redirect
        // target, and the whole point of the allowlist in oauth.ts is that
        // nothing outside it can be reached.
        //
        // Each page reads ?code= and POSTs it to /manage/auth/callback, so these
        // point at the SITE, not the Worker.
        "OAUTH_REDIRECT_URI": "https://autoboat.aoe.vt.edu/calendar/, https://autoboat.aoe.vt.edu/gallery/",

        // --- Gallery (Google Drive -> R2) -----------------------------------
        //
        // Id of the Drive folder whose images make up /gallery. PUBLIC: a
        // folder id is not a capability, because the service account still has
        // to be granted access.
        //
        // WARNING: This folder MUST live in a Shared Drive owned by the VT
        // Workspace (autoboat@vt.edu), not in anyone's personal My Drive. A
        // service account has no storage quota and cannot own files, so an
        // upload into My Drive fails with a quota error. A personal @gmail.com
        // account cannot create Shared Drives at all.
        //
        // Everything DIRECTLY inside this folder that is a displayable image
        // appears on the page. Subfolders are not traversed. Grab the id from
        // the folder URL: https://drive.google.com/drive/folders/<ID>
        "DRIVE_GALLERY_FOLDER_ID": "1ckC3ZTQEMA0P85eiybk_2ngAHv46QqRQ",

        // The service account's client_email, from its JSON key. NOT a secret
        // (it is an address, and it is the thing the folder is shared with).
        // The matching private key is the secret:
        //     wrangler secret put GOOGLE_PRIVATE_KEY
        "GOOGLE_SERVICE_ACCOUNT_EMAIL": "gallery-sync@gallery-sync-512417.iam.gserviceaccount.com"
        // OPTIONAL, for the fallback path only. If the VT Workspace plan has no
        // Shared Drives, set this to a Workspace user to act as, and a super
        // administrator must authorize the service account's client ID for
        // domain-wide delegation in the Admin console. Leave blank (the normal
        // case) when the folder is in a Shared Drive.
        // "GOOGLE_IMPERSONATE_EMAIL": "",
    },
    // Cron trigger for the gallery sync.
    //
    // WHY A CRON AT ALL: Drive offers no cheap "something changed" signal to a
    // Worker, and the requirement is that a photo dropped into the folder shows
    // up on the site with no redeploy. So the folder is polled.
    //
    // WHY EVERY 5 MINUTES: this is the worst-case delay for a photo added
    // through the Drive UI (an upload through the website mirrors immediately
    // and does not wait). It is deliberately aligned with
    // MANIFEST_TTL_SECONDS in src/gallerySync.ts, so the cron and a page-driven
    // refresh do not disagree about what "stale" means.
    //
    // WARNING: Each run costs ONE KV write, so 5 minutes is 288 writes/day.
    // Combined with the events cache (~480/day at a 180s TTL) that is still
    // well inside the free tier's 1,000 writes/day -- but the two budgets share
    // the same limit, so do not tighten either without redoing that arithmetic.
    // A run with nothing new still writes the manifest (to record `syncedAt`),
    // which is what keeps the cost predictable rather than bursty.
    "triggers": {
        "crons": ["*/5 * * * *"]
    },
    // R2 bucket holding the mirrored gallery images.
    //
    // WARNING: The gallery is served from R2, NOT from Drive. Drive's download
    // URLs are rate-limited and not meant for embedding, and its API quota is
    // per-user, so serving a public page from it would start failing under
    // ordinary traffic. Drive is the archive and the upload target; R2 is the
    // delivery mirror.
    //
    // Create it with:  npx wrangler r2 bucket create autoboat-gallery
    //
    // WARNING: The binding name MUST be `GALLERY_BUCKET`. Code reads
    // `env.GALLERY_BUCKET` (see handleGetGalleryImage in src/index.ts), so any
    // other binding name leaves that undefined and every image request answers
    // 503 "gallery not configured" -- while the manifest still lists the
    // photos, so the page shows broken tiles. A rename here is a rename there,
    // and src/test/worker/galleryConfig.test.ts fails if the two drift.
    "r2_buckets": [
        {
            "bucket_name": "autoboat-gallery",
            "binding": "GALLERY_BUCKET",
            "remote": true
        }
    ],
    // Smart placement is recommended for Workers that are latency-sensitive and
    // need to be close to users. This is the case for our Discord events API.
    "placement": {
        "mode": "smart"
    },
    // KV namespace for the events cache. Create the real IDs with:
    //     wrangler kv namespace create EVENTS_KV
    //     wrangler kv namespace create EVENTS_KV --preview
    // and paste the output ids below. The placeholder values intentionally
    // will NOT deploy; replace them before running `wrangler deploy`.
    "kv_namespaces": [
        {
            "binding": "EVENTS_KV",
            "id": "b83111739d3a428bba5984e44924a52a",
            "preview_id": "REPLACE_ME_KV_PREVIEW_ID",
            "remote": true
        }
    ]
}
