#!/usr/bin/env bash
# Pre-commit hook: keep external/cicd (and any future submodule under
# external/) read-only for humans.
#
# This file lives in the tracked .githooks/ directory and is activated
# automatically by the `prepare` npm/bun lifecycle script in package.json,
# which runs `git config core.hooksPath .githooks` on every install. No
# manual setup needed after cloning.
#
# What "read-only" means here:
#   - The submodule *pointer* (the commit SHA recorded in the superproject)
#     MAY be updated. In git's index, a submodule pointer is a "gitlink" entry
#     with mode 160000. Staging it (e.g. `git add external/cicd` after
#     `git submodule update --remote`) is allowed.
#   - File *contents* inside external/cicd may NOT be modified, added, or
#     deleted by hand. Those belong to the upstream repo
#     (https://code.vt.edu/s4-hosting-sites/cicd) and must be changed there.
#
# Detection: `git diff --cached --raw` lists staged changes with the entry
# mode. Gitlinks are mode 160000; regular files/dirs are 100644/100755/040000.
# We block any staged entry under external/ whose mode is NOT 160000.
set -euo pipefail

SUBMODULE_PATH="external"

# Format of `git diff --cached --raw` lines:
#   :<old mode> <new mode> <old sha> <new sha> <status>\t<path>
# For a staged gitlink (submodule pointer), <new mode> is 160000.
# For file content, <new mode> is 100644 / 100755 / 040000 etc.
# We block any staged entry under external/ whose mode is NOT 160000 —
# those are real content edits, not pointer bumps. Scoping to external/
# (not external/cicd) also catches someone adding stray files at
# external/sibling-path/ outside the submodule.
offending="$(
    git diff --cached --raw --ignore-submodules=none -- "$SUBMODULE_PATH" |
        awk -F'\t' '
            {
                # $1 is the ":mode mode sha sha status" prefix (colon-separated)
                # Split it on spaces to get the new (second) mode.
                n = split($1, parts, " ")
                new_mode = parts[2]
                path = $2
                if (new_mode != "160000") {
                    printf "  %s (mode %s)\n", path, new_mode
                }
            }
        '
)"

if [ -n "$offending" ]; then
    cat >&2 <<EOF
[pre-commit] BLOCKED: staged content changes inside $SUBMODULE_PATH

$SUBMODULE_PATH is a read-only git submodule. Its contents come from
  https://code.vt.edu/s4-hosting-sites/cicd
and must not be edited in this repo. To update it, bump the submodule
pointer instead:

  git submodule update --remote --merge external/cicd
  git add external/cicd
  git commit -m "chore(submodule): bump external/cicd"

Offending staged paths:
$offending

To bypass in an emergency (NOT recommended):
  git commit --no-verify
EOF
    exit 1
fi

exit 0
